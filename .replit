modules = ["web", "nodejs-22"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Masarak preview"

[[workflows.workflow]]
name = "Masarak preview"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_UNSTABLE_HEADLESS=1 npx expo start --web --host lan --port 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
